APP_ENV=development
APP_NAME=Noviq
API_HOST=0.0.0.0
API_PORT=8000

FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/noviq

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

REDIS_URL=redis://localhost:6379/0

# ---- Web Discovery ----
# Set to "brave" for production (requires BRAVE_SEARCH_API_KEY)
# Set to "ddg" for development/demo (no key needed, rate-limited)
SEARCH_PROVIDER=ddg
BRAVE_SEARCH_API_KEY=

# ---- Live Fetch ----
MAX_DISCOVERY_RESULTS=10
MAX_FETCH_CONCURRENCY=5
FETCH_TIMEOUT_SECONDS=10
MAX_RESPONSE_BYTES=5000000

# ---- Retrieval ----
BM25_TOP_K=20
SEMANTIC_TOP_K=20
HYBRID_TOP_K=10
RRF_K=60
SEMANTIC_SCORE_THRESHOLD=0.50

# ---- LLM (optional for real AI answers) ----
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---- Security ----
ENABLE_PROMPT_INJECTION_SCAN=true
ENABLE_TRUST_SCORING=true
ENABLE_SECURITY_GATE=true

# ---- Agent ----
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
MAX_SUBQUERIES=4
MAX_VERIFICATION_SOURCES=5
MAX_SOURCE_CHARS=4000
MAX_AGENT_ITERATIONS=3
MAX_RETRIEVAL_ROUNDS=2
